#!/usr/bin/env bash
# roost-trust <dir>: mark a directory as trusted in ~/.claude.json so headless
# Claude Code (Remote Control) doesn't stop at the "Trust this folder?" prompt.
set -euo pipefail

dir="$(cd "${1:?usage: roost-trust <dir>}" && pwd)"
cfg="$HOME/.claude.json"
[ -f "$cfg" ] || exit 0

if jq -e --arg p "$dir" '.projects[$p].hasTrustDialogAccepted == true' "$cfg" > /dev/null 2>&1; then
  exit 0
fi

tmp="$(mktemp "$cfg.XXXXXX")"
if jq --arg p "$dir" '.projects[$p] = ((.projects[$p] // {}) + {hasTrustDialogAccepted: true})' "$cfg" > "$tmp"; then
  mv "$tmp" "$cfg"
else
  rm -f "$tmp"
fi
