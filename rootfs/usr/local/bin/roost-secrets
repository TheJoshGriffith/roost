#!/usr/bin/env bash
# roost-secrets [list]: show which secrets and SSH keys roost provides. Never prints values.
set -euo pipefail
vault="${HOME:-/config/home}/.config/roost/vault.json"
if [ ! -s "$vault" ]; then
  echo "No secrets or SSH keys yet. Add them in the roost dashboard: Secrets."
  exit 0
fi
case "${1:-list}" in
  list | ls)
    echo "Environment variables (values hidden):"
    jq -r '.env | to_entries[] | "  \(.key)\(if .value.description != "" then "  - " + .value.description else "" end)\(if .value.gitHost then "  [git: " + .value.gitHost + "]" else "" end)"' "$vault"
    echo
    echo "SSH keys:"
    jq -r '.keys | to_entries[] | "  \(.key)  -> \(if (.value.hosts | length) > 0 then (.value.hosts | join(", ")) else "any host" end)"' "$vault"
    ;;
  *)
    echo "usage: roost-secrets [list]"
    exit 2
    ;;
esac
